<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Beep durante ligação (ver CallDetector/Beeper): toca no stream de voz da
         chamada em andamento, permissão "normal" concedida na instalação, sem
         diálogo de runtime. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Guarda de áudio: a pasta "WhatsApp Voice Notes" fica sob Android/media com
         .nomedia (não indexada pelo MediaStore). Ler outro app exige All Files Access
         no Android 11+; abaixo disso, leitura direta de arquivo. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- SEC-0066: banco local espelha conversas do WhatsApp (dados sensíveis de
         terceiros). Backup/transfer desabilitados para impedir extração via
         auto-backup Google Drive, migração device-to-device e adb backup. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="WA Keeper"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.WaNotifKeeper">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RetentionActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".NotifListenerService"
            android:exported="true"
            android:label="WA Keeper"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
