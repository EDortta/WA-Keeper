<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Mensagens agendadas devem disparar no horário pedido. Em Android 12+ esse
         acesso é especial e pode ser revogado pelo usuário; o código verifica
         canScheduleExactAlarms() e degrada para alarme inexato sem perder a fila. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Beep durante ligação (ver CallDetector/Beeper): toca no stream de voz da
         chamada em andamento, permissão "normal" concedida na instalação, sem
         diálogo de runtime. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Guarda de áudio: a pasta "WhatsApp Voice Notes" fica sob Android/media com
         .nomedia (não indexada pelo MediaStore). Ler outro app exige All Files Access
         no Android 11+; abaixo disso, leitura direta de arquivo. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Comandos de voz (ver NotifListenerService.runVoiceGateLoop): microfone só
         ligado enquanto a janela de ativação (movimento/timer) está aberta, com
         serviço em primeiro plano do tipo "microphone" — exigência do Android 14
         pra captura de áudio em segundo plano. Reconhecimento é só on-device
         (ver plano) — nenhum áudio sai do aparelho. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- SEC-0066: banco local espelha conversas do WhatsApp (dados sensíveis de
         terceiros). Backup/transfer desabilitados para impedir extração via
         auto-backup Google Drive, migração device-to-device e adb backup. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="WA Keeper"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.WaNotifKeeper">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EntitiesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".EntityDetailActivity"
            android:exported="false"
            android:parentActivityName=".EntitiesActivity" />

        <activity
            android:name=".EntityAssociationsActivity"
            android:exported="false"
            android:parentActivityName=".EntityDetailActivity" />

        <activity
            android:name=".ConversationImportActivity"
            android:exported="true"
            android:theme="@style/Theme.WaNotifKeeper">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConversationActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:parentActivityName=".ConversationActivity" />

        <activity
            android:name=".RetentionActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ScheduledMessagesActivity"
            android:exported="false"
            android:parentActivityName=".DetailActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".MediaShareAccessibilityService"
            android:exported="true"
            android:label="WA Keeper — envio de mídia"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/media_share_accessibility_service" />
        </service>

        <service
            android:name=".NotifListenerService"
            android:exported="true"
            android:label="WA Keeper"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ScheduledMessageAlarmReceiver"
            android:exported="false" />

    </application>
</manifest>
