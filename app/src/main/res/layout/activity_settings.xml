<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Ajustes"
        app:titleTextColor="#1C1C1E" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Leitura em voz alta em movimento"
                android:textColor="#1C1C1E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Quando o aparelho detecta que você está em movimento, as mensagens que chegam são lidas em voz alta. Escolha para quais contas."
                android:textColor="#636366"
                android:textSize="13sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:text="WhatsApp"
                        android:textColor="#1C1C1E"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="#E5E5EA" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swBusiness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:text="WhatsApp Business"
                        android:textColor="#1C1C1E"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="A leitura usa o mecanismo de voz do próprio Android e respeita o áudio do carro. Nenhum dado sai do aparelho."
                android:textColor="#8A8A8E"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="4dp"
                android:text="Guardar áudios de voz recebidos"
                android:textColor="#1C1C1E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Copia o áudio de voz recebido para o aparelho assim que ele chega — mesmo que a pessoa apague depois. Precisa da permissão de acesso a todos os arquivos."
                android:textColor="#636366"
                android:textSize="13sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAudioWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:text="Guardar áudios — WhatsApp"
                        android:textColor="#1C1C1E"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="#E5E5EA" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAudioBusiness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:text="Guardar áudios — Business"
                        android:textColor="#1C1C1E"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="#E5E5EA" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAudioMotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp"
                        android:text="Tocar áudio recebido em movimento"
                        android:textColor="#1C1C1E"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvAudioPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFF4E5"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp"
                android:text="⚠️  Toque para conceder “Acesso a todos os arquivos” — necessário para ler a pasta de áudios do WhatsApp."
                android:textColor="#8A5A00"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Só áudios recebidos, e só o que já foi baixado. A correlação com o remetente é por horário, então pode falhar em rajada de áudios de vários contatos."
                android:textColor="#8A8A8E"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="4dp"
                android:text="Comandos de voz"
                android:textColor="#1C1C1E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Diga “Jeeves” antes do comando (ex.: “Jeeves, leia as últimas mensagens de Fulano”). Escuta ativa só em movimento ou por um tempo manual, e nunca durante ligação. Reconhecimento 100% no aparelho — nenhum áudio sai daqui."
                android:textColor="#636366"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVoiceUnsupported"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requer Android 12 ou mais recente."
                android:textColor="#8A8A8E"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/groupVoiceCommands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swVoiceCommands"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:paddingHorizontal="12dp"
                            android:text="Ativar comandos de voz"
                            android:textColor="#1C1C1E"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="#E5E5EA" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingTop="12dp"
                            android:text="Conta padrão"
                            android:textColor="#1C1C1E"
                            android:textSize="14sp" />

                        <RadioGroup
                            android:id="@+id/rgVoiceAccount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingBottom="8dp">

                            <RadioButton
                                android:id="@+id/rbVoiceWhatsapp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="WhatsApp"
                                android:textColor="#1C1C1E"
                                android:textSize="14sp" />

                            <RadioButton
                                android:id="@+id/rbVoiceBusiness"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Business"
                                android:textColor="#1C1C1E"
                                android:textSize="14sp" />

                        </RadioGroup>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="#E5E5EA" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingTop="12dp"
                            android:text="Ouvir por um tempo (mesmo parado)"
                            android:textColor="#1C1C1E"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimer15m"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="15m"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimer30m"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="30m"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimer1h"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="1h"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingBottom="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimer2h"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="2h"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimer4h"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="4h"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTimer8h"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="8h"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/tvVoiceTimerStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Timer manual desligado"
                                android:textColor="#636366"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/btnVoiceTimerStop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="4dp"
                                android:text="Parar agora"
                                android:textColor="#128C7E"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvVoicePermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#FFF4E5"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="14dp"
                    android:text="⚠️  Toque para conceder acesso ao microfone e às notificações — necessário para os comandos de voz."
                    android:textColor="#8A5A00"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVoiceSpeechPackMissing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#FFF4E5"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="14dp"
                    android:text="⚠️  Pacote de voz em português não encontrado no aparelho. Toque para abrir as configurações de voz do sistema e baixá-lo."
                    android:textColor="#8A5A00"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
