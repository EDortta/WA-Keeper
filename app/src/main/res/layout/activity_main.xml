<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Banner de permissão -->
    <TextView
        android:id="@+id/bannerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E53935"
        android:foreground="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="⚠️  Toque aqui para ativar o acesso a notificações"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Search bar flutuante + acesso aos ajustes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <EditText
            android:id="@+id/searchField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Buscar em todas as conversas..."
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textColor="#1C1C1E"
            android:textColorHint="#8A8A8E"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ajustes"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        app:tabIndicatorColor="#25D366"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#25D366"
        app:tabTextColor="#636366"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabRippleColor="#1A25D366">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todos" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Business" />

    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E5EA" />

    <!-- paddingBottom deixa espaço para o botão de microfone não cobrir o último cartão -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="96dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhuma mensagem salva ainda"
            android:textColor="#636366"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="As notificações do WhatsApp\naparecerão aqui automaticamente"
            android:gravity="center"
            android:textColor="#8A8A8E"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>

    <!--
        Botão de microfone. Enquanto a palavra de ativação ("Godofredo") não é confiável no
        reconhecedor on-device, este é o caminho direto: tocar e falar o comando, sem depender
        de o aparelho ouvir a palavra certa. Centralizado embaixo, sobre a lista.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="Falar um comando"
        android:src="@android:drawable/ic_btn_speak_now"
        app:backgroundTint="#25D366"
        app:tint="#FFFFFF"
        app:fabSize="normal"
        app:elevation="6dp" />

    <TextView
        android:id="@+id/tvMicHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_search"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="Pode falar o comando"
        android:textColor="#1C1C1E"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
