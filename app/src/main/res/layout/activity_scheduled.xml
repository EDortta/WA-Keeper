<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Mensagens programadas"
        app:titleTextColor="#1C1C1E" />

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1C1C1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escolha quando tentar enviar. O WhatsApp precisa expor uma ação de resposta compatível; se não expuser, o motivo fica registrado aqui."
                android:textColor="#8A8A8E"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:hint="Texto ou legenda (opcional se houver anexo)"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#1C1C1E"
                android:textColorHint="#8A8A8E"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Anexar imagem, vídeo, áudio ou documento" />

            <TextView
                android:id="@+id/tvAttachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sem anexo"
                android:textColor="#8A8A8E"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgTrigger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioNextIncoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Quando esta pessoa mandar a próxima mensagem" />

                <RadioButton
                    android:id="@+id/radioAtTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Em uma data e hora" />
            </RadioGroup>

            <Button
                android:id="@+id/btnDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Escolher data e hora"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnArm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Programar mensagem" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Nenhuma mensagem programada para esta conversa."
                android:textColor="#8A8A8E"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerArmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
