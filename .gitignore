# Build outputs
build/
app/build/
.gradle/
.claude*

.gk/

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.artifacts/

# Chaves e config local — nunca versionar (SEC-0066)
local.properties
*.jks
*.keystore
keystore.properties

# Criados pelo helper `awt` dentro de cada worktree — .credentials/store é um
# symlink para ~/.config/credentials/personal. Um `git add -A` distraído
# versionaria o ponteiro para o cofre pessoal.
.credentials/
.env
gradle.properties

# Backups locais podem conter dados pessoais e nunca devem ser versionados
local-backup/

# Local signing material and private diagnostics
release.properties
*.keystore
*.jks
**/private/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Raw ADB diagnostic captures may contain private data
wa-keeper-diagnose-*/

# Godofredo benchmark: transcrições brutas são somente locais
diagnostics/godofredo-device-benchmark/**/raw/
